# Automatically normalize text files in the Git index.
* text=auto

# Source code
*.java       text eol=lf
*.js         text eol=lf
*.cjs        text eol=lf
*.mjs        text eol=lf
*.jsx        text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.sql        text eol=lf

# Configuration and structured data
*.json       text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.properties text eol=lf
*.toml       text eol=lf
*.lock       text eol=lf
.env*        text eol=lf
*.example    text eol=lf

# Documentation
*.md         text eol=lf
*.txt        text eol=lf

# Unix, build, and container files
*.sh         text eol=lf
mvnw         text eol=lf
Dockerfile*  text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.dockerignore  text eol=lf
.editorconfig  text eol=lf
.npmrc          text eol=lf

# Windows-native scripts
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Images and design assets
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.avif       binary
*.ico        binary
*.bmp        binary
*.svg        text eol=lf

# Fonts
*.woff       binary
*.woff2      binary
*.ttf        binary
*.otf        binary
*.eot        binary

# Archives, packaged artifacts, and compiled output
*.zip        binary
*.gz         binary
*.tgz        binary
*.tar        binary
*.7z         binary
*.jar        binary
*.war        binary
*.class      binary

# Documents and media
*.pdf        binary
*.mp3        binary
*.wav        binary
*.mp4        binary
*.webm       binary
